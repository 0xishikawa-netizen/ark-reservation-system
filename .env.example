# ------------------------------------------------------------------
# ARK 予約・決済システム — 環境変数サンプル
# 本ファイルはコミットする。実値の .env は絶対にコミットしない。
# ------------------------------------------------------------------

APP_NAME="ARK Reservation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tokyo

# 顧客 PII（電話番号など）の等価検索用 HMAC キー。APP_KEY とは別に管理する。
# 生成例: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# 本番/STG では必ず一意の値を設定。空だと顧客の HMAC 計算が例外になる。
PII_LOOKUP_KEY=

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
# 技術ログ保持日数（daily ローテーション）
LOG_DAILY_DAYS=30

# ------------------------------------------------------------------
# データベース（専用 DB。WordPress DB には絶対に接続しない）
# 実バージョン確定まで 8.0 系イメージを使用（Phase 0 実測で確定）
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ark_app
DB_USERNAME=ark
DB_PASSWORD=secret

# ------------------------------------------------------------------
# セッション / キャッシュ / キュー（すべて DB ドライバで統一＝1 人保守向け）
# ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false        # 本番/STG は true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------
# メール（ローカルは Mailpit。LINE/Slack 通知は将来）
# ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ark-conditioning.local"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_ALERT_EMAIL="owner@example.com"   # failed_jobs / DB 容量 / バックアップ通知先

# ------------------------------------------------------------------
# 予約 / 外部連携（Phase 1〜8 は local + null で完結）
# ------------------------------------------------------------------
# 予約の System of Record: local | peak_manager | salon_board
RESERVATION_AUTHORITY=local
# 外部ゲートウェイ実装: null | peak_manager | salon_board
EXTERNAL_RESERVATION_GATEWAY=null
# 予約スロット粒度（分）。OPEN_QUESTIONS #9
RESERVATION_SLOT_MINUTES=15
# 仮予約（pending_payment）の枠 HOLD 時間（分）
RESERVATION_HOLD_MINUTES=10
# 管理者の任意時刻予約を許可するか（true なら floor/ceil で占有スロット生成）
RESERVATION_ALLOW_ADMIN_FREE_TIME=false

# 外部 API 認証情報（Phase 10 まで空。実 API へは接続しない）
PEAK_MANAGER_BASE_URL=
PEAK_MANAGER_API_KEY=
SALON_BOARD_BASE_URL=
SALON_BOARD_API_KEY=

# ------------------------------------------------------------------
# Stripe（初期は必ず Test Mode。Live キーは local/STG で使用禁止）
# ------------------------------------------------------------------
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP
# manual capture を第一候補にするか（与信二段階。OPEN_QUESTIONS #10b）
# Phase 5 の承認済み仕様により manual capture を既定とする
STRIPE_CAPTURE_METHOD=manual        # automatic | manual
# Stripe API HTTP タイムアウト / SDK ネットワークリトライ
STRIPE_HTTP_TIMEOUT=30
STRIPE_HTTP_CONNECT_TIMEOUT=10
STRIPE_MAX_NETWORK_RETRIES=2
# Webhook raw payload の暗号化オフDB短期保管（OPEN_QUESTIONS #10。既定 off）
STRIPE_ARCHIVE_WEBHOOK_PAYLOAD=false
STRIPE_ARCHIVE_WEBHOOK_DISK=local
STRIPE_ARCHIVE_WEBHOOK_DAYS=30

# ------------------------------------------------------------------
# 保持期間（config/retention.php が参照。値は OPEN_QUESTIONS #3 で確定）
# ------------------------------------------------------------------
RETENTION_WEBHOOK_EVENTS_DAYS=90
RETENTION_SYNC_LOGS_SUCCESS_DAYS=30
RETENTION_SYNC_LOGS_FAILED_DAYS=180
RETENTION_AUDIT_LOGS_LOW_DAYS=365
RETENTION_RESERVATION_SLOTS_PAST_DAYS=14
DB_SIZE_ALERT_MB=3584               # 5GB の約 70%

# ------------------------------------------------------------------
# フロント
# ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Laravel 標準（scaffold 由来。既定値で概ね動作）
# ------------------------------------------------------------------
APP_FAKER_LOCALE=ja_JP
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_DEPRECATIONS_CHANNEL=null
MAIL_SCHEME=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SESSION_PATH=/
SESSION_DOMAIN=null
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
