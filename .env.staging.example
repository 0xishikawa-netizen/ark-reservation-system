# ------------------------------------------------------------------
# ARK 予約・決済システム — お試し環境（Staging）用サンプル（Task 11-36）
# サーバー上で .env にコピーして値を埋める。実値の .env は絶対にコミットしない。
# 手順は docs/STAGING_DEPLOY.md。
# ------------------------------------------------------------------

APP_NAME="ARK Reservation"
APP_ENV=staging
# php artisan key:generate で自動設定される
APP_KEY=
APP_DEBUG=false
APP_URL=https://stg.ark-conditioning.com
APP_TIMEZONE=Asia/Tokyo

# 生成: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
PII_LOOKUP_KEY=

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------
# お試し環境の入口（config/staging.php）
# ------------------------------------------------------------------
# 関係者だけが見られるよう共通 ID / パスワードを掛ける（両方設定で有効）
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
# 開発用メニュー /dev-menu を表示する
STAGING_DEV_MENU=true
# デモアカウント共通パスワード（12 文字以上。未設定だと db:seed が止まる）
STAGING_DEMO_PASSWORD=

# ------------------------------------------------------------------
# データベース：お試し用 DB（64ssq_ark_test）。WordPress の DB（64ssq_ark_db）は絶対に指定しない
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql1002.onamae.ne.jp
DB_PORT=3306
DB_DATABASE=64ssq_ark_test
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------
# メール：お試し環境では送信せずログへ書く
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@stg.ark-conditioning.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_ALERT_EMAIL=

# 開発用管理者（staging のパスワードは STAGING_DEMO_PASSWORD を使う）
DEV_ADMIN_NAME="ARK 開発管理者"
DEV_ADMIN_EMAIL="dev-admin@ark.test"

# ------------------------------------------------------------------
# 予約 / 外部連携：お試し環境では外部連携しない
# ------------------------------------------------------------------
RESERVATION_AUTHORITY=local
EXTERNAL_RESERVATION_GATEWAY=null
RESERVATION_INTEGRATION_PROVIDER=null
RESERVATION_SLOT_MINUTES=5
RESERVATION_HOLD_MINUTES=10
RESERVATION_ALLOW_ADMIN_FREE_TIME=false

# ------------------------------------------------------------------
# Stripe：必ず Test キー（pk_test_ / sk_test_）。Live キーは起動時に拒否される
# ------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP
STRIPE_CAPTURE_METHOD=manual
STRIPE_HTTP_TIMEOUT=30
STRIPE_HTTP_CONNECT_TIMEOUT=10
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_ARCHIVE_WEBHOOK_PAYLOAD=false

VITE_APP_NAME="${APP_NAME}"

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SESSION_PATH=/
SESSION_DOMAIN=null

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BACKUP_DISK_DRIVER=local
BACKUP_DISK_ROOT=
